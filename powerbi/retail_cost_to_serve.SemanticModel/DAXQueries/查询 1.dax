// 欢迎使用 DAX 查询视图!要详细了解 DAX 查询，请访问 https://aka.ms/dax-queries。
// 右键单击数据窗格中的表、列或度量值以访问快速查询，或向 Copilot 寻求有关编写 DAX 的帮助。
// Measures for the Retail Sales & Cost-to-Serve report.
// Paste into Power BI Desktop > DAX query view, click "Update model with changes" to add them,
// then Run to check the yearly figures in the result grid.
// Revenue = item price of delivered orders (is_revenue = TRUE). Freight is a cost, not revenue.

DEFINE
	MEASURE fact_order_item[Revenue] =
		CALCULATE ( SUM ( fact_order_item[price] ), fact_order_item[is_revenue] = TRUE () )
	MEASURE fact_order_item[Orders] =
		CALCULATE ( DISTINCTCOUNT ( fact_order_item[order_id] ), fact_order_item[is_revenue] = TRUE () )
	MEASURE fact_order_item[Avg Order Value] =
		DIVIDE ( [Revenue], [Orders] )
	MEASURE fact_order_item[Freight] =
		CALCULATE ( SUM ( fact_order_item[freight_value] ), fact_order_item[is_revenue] = TRUE () )
	MEASURE fact_order_item[Freight %] =
		DIVIDE ( [Freight], [Revenue] )
	MEASURE fact_order_item[Late %] =
		DIVIDE (
			CALCULATE ( COUNTROWS ( fact_order_item ), fact_order_item[is_revenue] = TRUE (), fact_order_item[is_late] = TRUE () ),
			CALCULATE ( COUNTROWS ( fact_order_item ), fact_order_item[is_revenue] = TRUE (), NOT ISBLANK ( fact_order_item[is_late] ) )
		)
	MEASURE fact_order_item[Avg Delivery Days] =
		CALCULATE ( AVERAGE ( fact_order_item[delivery_days] ), fact_order_item[is_revenue] = TRUE () )
	MEASURE fact_order_item[Avg Distance km] =
		CALCULATE ( AVERAGE ( fact_order_item[distance_km] ), fact_order_item[is_revenue] = TRUE () )
	MEASURE fact_order_item[Avg Review] =
		CALCULATE ( AVERAGE ( fact_order_item[review_score] ), fact_order_item[is_revenue] = TRUE () )
	MEASURE fact_order_item[Revenue PY] =
		CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
	MEASURE fact_order_item[Revenue YoY %] =
		DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
	MEASURE fact_budget[Budget] =
		SUM ( fact_budget[budget_revenue] )
	MEASURE fact_budget[Variance] =
		[Revenue] - [Budget]
	MEASURE fact_budget[Variance %] =
		DIVIDE ( [Variance], [Budget] )

EVALUATE
	SUMMARIZECOLUMNS (
		dim_date[year],
		"Revenue", [Revenue],
		"Orders", [Orders],
		"Freight %", [Freight %],
		"Budget", [Budget]
	)