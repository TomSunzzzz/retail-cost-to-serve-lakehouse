table fact_budget
	lineageTag: f08be797-59d3-49ac-930b-49df8dcb8583

	measure Budget = SUM ( fact_budget[budget_revenue] )
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		lineageTag: 4723258b-007b-48d4-b38e-7d0b81196d20

	measure Variance = [Revenue] - [Budget]
		formatString: \R$ #,0;-\R$ #,0;\R$ #,0
		lineageTag: 6810b6d9-806f-4bc0-8c34-9ac18a2deca5

	measure 'Variance %' = DIVIDE ( [Variance], [Budget] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 691a4f6f-ffd2-4505-83b7-be4d5b9536ea

